# syntax=docker/dockerfile:1.7

ARG VLLM_STT_BASE_IMAGE
FROM ${VLLM_STT_BASE_IMAGE}

ARG VLLM_STT_AUDIO_VERSION

USER root

# Must exist before any uv command.
ENV UV_SYSTEM_CERTS=true

RUN test -n "${VLLM_STT_AUDIO_VERSION}" || \
    (echo "VLLM_STT_AUDIO_VERSION build arg is required" >&2; exit 1)

RUN --mount=type=secret,id=corporate_ca \
    set -eux; \
    \
    if [ -f /run/secrets/corporate_ca ]; then \
        cp /run/secrets/corporate_ca \
           /usr/local/share/ca-certificates/corporate-ca.crt; \
        update-ca-certificates; \
    fi; \
    \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    \
    uv pip install \
        --system \
        --system-certs \
        "vllm[audio]==${VLLM_STT_AUDIO_VERSION}"