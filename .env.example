# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# LLM (OpenAI-compatible vLLM)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local-not-a-secret
LLM_MODEL_NAME=qwen3-4b-awq
LLM_TEMPERATURE=0.15
LLM_MAX_COMPLETION_TOKENS=320

# Speech-to-text (OpenAI-compatible vLLM)
STT_BASE_URL=http://127.0.0.1:8001/v1
STT_API_KEY=local-not-a-secret
STT_MODEL=qwen3-asr-0.6b
STT_LANGUAGE=en
STT_TTFS_P99_SECONDS=0.8

# Text-to-speech (vLLM-Omni)
TTS_BASE_URL=http://127.0.0.1:8002/v1
# TTS_API_KEY=
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_VOICE=vivian
TTS_LANGUAGE=English
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_REQUEST_TIMEOUT_SECONDS=60

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Qdrant. Use QDRANT_URL in shared/production deployments.
QDRANT_COLLECTION=echolex
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_TIMEOUT_SECONDS=5

# Retrieval
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55
RAG_RETRIEVAL_TIMEOUT_SECONDS=1.5
RAG_MAX_CONTEXT_CHARS=6000

# Ingestion safety limits
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=180
INGEST_BATCH_SIZE=64
ALLOW_COLLECTION_RECREATE=false
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=2000

# Health checks
HEALTH_TIMEOUT_SECONDS=3

# Observability overlay
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-use
