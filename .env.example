# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

AUDIO_IN_SAMPLE_RATE=16000

# -----------------------------------------------------------------------------
# Shared vLLM runtime
# -----------------------------------------------------------------------------
HF_HOME=/root/.cache/huggingface
VLLM_USE_V2_MODEL_RUNNER=0

VLLM_LLM_IMAGE=vllm/vllm-openai:v0.28.0
VLLM_TTS_IMAGE=vllm/vllm-omni:v0.28.0
VLLM_STT_BASE_IMAGE=vllm/vllm-openai:v0.28.0
VLLM_STT_AUDIO_VERSION=0.28.0
VLLM_STT_IMAGE=echolex-vllm-stt:v0.28.0

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local-not-a-secret

LLM_MODEL_REPOSITORY=Qwen/Qwen3-0.6B
LLM_MODEL_NAME=qwen3-0.6b

LLM_DTYPE=bfloat16
LLM_QUANTIZATION=none

LLM_GPU_MEMORY_UTILIZATION=0.30
LLM_MAX_MODEL_LEN=4096
LLM_MAX_NUM_SEQS=1
LLM_ENFORCE_EAGER=true

LLM_TEMPERATURE=0.15
LLM_MAX_COMPLETION_TOKENS=320

# -----------------------------------------------------------------------------
# STT
# -----------------------------------------------------------------------------
STT_BASE_URL=http://127.0.0.1:8001/v1
STT_API_KEY=local-not-a-secret

STT_MODEL_REPOSITORY=Qwen/Qwen3-ASR-0.6B
STT_MODEL=qwen3-asr-0.6b

STT_DTYPE=bfloat16
STT_QUANTIZATION=none

STT_GPU_MEMORY_UTILIZATION=0.30
STT_MAX_MODEL_LEN=3072
STT_MAX_NUM_SEQS=1
STT_ENFORCE_EAGER=true

STT_LANGUAGE=en
STT_TTFS_P99_SECONDS=0.8

# -----------------------------------------------------------------------------
# TTS
# -----------------------------------------------------------------------------
TTS_BASE_URL=http://127.0.0.1:8002/v1
TTS_API_KEY=

TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

TTS_DTYPE=bfloat16
TTS_QUANTIZATION=none

TTS_VOICE=vivian
TTS_LANGUAGE=English
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000

TTS_REQUEST_TIMEOUT_SECONDS=60
TTS_HTTP_CONNECT_TIMEOUT_SECONDS=3

TTS_RESPONSE_FORMAT=pcm
TTS_STREAM_FORMAT=audio
TTS_STREAM=true
TTS_LOG_STATS=true

TTS_STAGE0_GPU_MEMORY_UTILIZATION=0.25
TTS_STAGE0_MAX_NUM_SEQS=1
TTS_STAGE0_ENFORCE_EAGER=true

TTS_STAGE1_GPU_MEMORY_UTILIZATION=0.20
TTS_STAGE1_MAX_NUM_SEQS=1
TTS_STAGE1_ENFORCE_EAGER=true

# -----------------------------------------------------------------------------
# Embedding / RAG
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PROMPT=Represent this sentence for searching relevant passages:

RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55
RAG_RETRIEVAL_TIMEOUT_SECONDS=1.5
RAG_MAX_CONTEXT_CHARS=6000

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=180
INGEST_BATCH_SIZE=64

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_COLLECTION=echolex
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_TIMEOUT_SECONDS=5

ALLOW_COLLECTION_RECREATE=false

MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=2000

# -----------------------------------------------------------------------------
# Health / observability
# -----------------------------------------------------------------------------
HEALTH_TIMEOUT_SECONDS=3

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

PROMETHEUS_SCRAPE_INTERVAL=5s
PROMETHEUS_EVALUATION_INTERVAL=5s
PROMETHEUS_RETENTION=7d