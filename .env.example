# -------------------- vLLM --------------------
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_MODEL_NAME=qwen2.5-7b-instruct
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
LLM_TEMPERATURE=0.15
LLM_MAX_COMPLETION_TOKENS=320

# -------------------- Local speech server (Speaches) --------------------
SPEACHES_BASE_URL=http://127.0.0.1:8001/v1
STT_MODEL=Systran/faster-distil-whisper-small.en
STT_LANGUAGE=en
STT_TTFS_P99_SECONDS=0.8
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000

# -------------------- Embeddings / Qdrant --------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
QDRANT_COLLECTION=talkdoc
# Leave QDRANT_URL blank to use embedded persistent Qdrant at QDRANT_PATH.
QDRANT_URL=
QDRANT_PATH=./data/qdrant
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55
RAG_RETRIEVAL_TIMEOUT_SECONDS=1.5
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=180

# -------------------- Pipecat --------------------
LOG_LEVEL=INFO
