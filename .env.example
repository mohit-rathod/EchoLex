# ============================================================
# LLM
# ============================================================

# OpenAI-compatible vLLM endpoint.
LLM_BASE_URL=http://127.0.0.1:8000/v1

# Must match --served-model-name in docker-compose.yml.
LLM_MODEL_NAME=qwen3-4b-awq

LLM_TEMPERATURE=0.15
LLM_MAX_COMPLETION_TOKENS=320


# ============================================================
# STT
# ============================================================

# OpenAI-compatible transcription endpoint exposed by vLLM.
STT_BASE_URL=http://127.0.0.1:8001/v1

# Must match --served-model-name in docker-compose.yml.
STT_MODEL=qwen3-asr-0.6b

# Set this to an empty value if you want the ASR model/service
# to perform automatic language detection where supported.
STT_LANGUAGE=en

STT_TTFS_P99_SECONDS=0.8


# ============================================================
# TTS
# ============================================================

# vLLM-Omni endpoint.
TTS_BASE_URL=http://127.0.0.1:8002/v1

TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# Qwen3-TTS CustomVoice speaker.
TTS_VOICE=vivian

TTS_LANGUAGE=English

# IMPORTANT:
# The current adapter requests streaming raw PCM audio.
# Keep speed at 1.0 for this vLLM-Omni streaming mode.
TTS_SPEED=1.0

TTS_SAMPLE_RATE=24000


# ============================================================
# Embeddings
# ============================================================

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Embeddings are intentionally kept on CPU so that the GPU is available
# for STT, LLM and TTS inference.
EMBEDDING_DEVICE=cpu


# ============================================================
# Qdrant
# ============================================================

QDRANT_COLLECTION=echolex

# Leave empty to use embedded/local Qdrant storage.
# Configure this when using a standalone Qdrant server.
QDRANT_URL=

QDRANT_PATH=./data/qdrant


# ============================================================
# RAG
# ============================================================

RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.55
RAG_RETRIEVAL_TIMEOUT_SECONDS=1.5


# ============================================================
# PDF chunking
# ============================================================

CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=180


# ============================================================
# Logging
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# vLLM compatibility
# ============================================================

# This is the configuration used while testing this repository.
# It is unrelated to Zscaler.
#
# Users can change it after validating vLLM Model Runner V2 with
# their own GPU and model combination.
VLLM_USE_V2_MODEL_RUNNER=0
