    {
      "id": 2,
      "type": "stat",
      "title": "Scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "min by (model_service) (up{job=~\"vllm-.*\",model_service=~\"$model\"})",
          "legendFormat": "{{model_service}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "description": "1 means Prometheus can scrape the model server; 0 means the target is unavailable."
    },
